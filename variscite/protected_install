#!/bin/bash

_name=${1}	
repeated_cnt=5;
RET_CODE=1;

echo Installing ${_name}
for (( c=0; c<${repeated_cnt}; c++ ))
do
	apt install -y ${_name} && {
		RET_CODE=0;
		break;
	};
	echo
	echo "##########################"
	echo "## Fix missing packages ##"
	echo "##########################"
	echo

	sleep 2;

	# Remediation between attempts, never a success condition: with nothing
	# broken this exits 0, and treating that as success would report the
	# package installed without ever installing it.
	apt --fix-broken install -y
done

exit ${RET_CODE}
